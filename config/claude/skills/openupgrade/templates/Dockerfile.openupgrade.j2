#
# Builds an Odoo image based on the OpenUpgrade fork for the target
# version. The fork ships the OpenUpgrade migration scripts inside the
# core modules; running this image with `-u all` against a database
# previously at version SOURCE_VERSION will trigger the migrations.

FROM python:{{ python_version }}-slim-bookworm

ARG OPENUPGRADE_REPO=https://github.com/OCA/OpenUpgrade.git
ARG OPENUPGRADE_BRANCH={{ target_version }}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        gnupg \
        libldap2-dev \
        libpq-dev \
        libsasl2-dev \
        libxml2-dev \
        libxslt1-dev \
        libjpeg-dev \
        libfreetype6-dev \
        libtiff5-dev \
        zlib1g-dev \
        libssl-dev \
        node-less \
        npm \
        postgresql-client \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

# wkhtmltopdf is required for PDF reports. We pull the patched 0.12.6.1-3
# release recommended by Odoo for the target architecture.
RUN ARCH=$(dpkg --print-architecture) \
 && case "$ARCH" in \
        amd64) WKHTML_PKG=wkhtmltox_0.12.6.1-3.bookworm_amd64.deb ;; \
        arm64) WKHTML_PKG=wkhtmltox_0.12.6.1-3.bookworm_arm64.deb ;; \
        *) echo "Unsupported arch $ARCH"; exit 1 ;; \
    esac \
 && curl -fsSL -o /tmp/wkhtml.deb \
        https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-3/${WKHTML_PKG} \
 && apt-get update \
 && apt-get install -y --no-install-recommends /tmp/wkhtml.deb \
 && rm -f /tmp/wkhtml.deb \
 && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "${OPENUPGRADE_BRANCH}" \
        "${OPENUPGRADE_REPO}" /opt/openupgrade \
 && pip install --upgrade pip setuptools wheel \
 && pip install -r /opt/openupgrade/requirements.txt \
 && pip install -e /opt/openupgrade

RUN useradd -m -d /var/lib/odoo -s /bin/bash odoo \
 && mkdir -p /var/lib/odoo /etc/odoo /mnt/extra-addons \
 && chown -R odoo:odoo /var/lib/odoo /etc/odoo /mnt/extra-addons

USER odoo
WORKDIR /var/lib/odoo

EXPOSE 8069 8072

ENTRYPOINT ["odoo"]
