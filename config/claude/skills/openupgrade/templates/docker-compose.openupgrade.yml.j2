# Generated by the openupgrade skill. Do not edit by hand; regenerate via
# scripts/render_migration_stack.py.
#
# Runs the OpenUpgrade-flavoured Odoo against the migration database, on
# the migration filestore volume, joining the existing project network so
# it can reach the project's Postgres container by its service name.
# The original Odoo service from the project compose file is NOT started.

services:
  openupgrade:
    container_name: openupgrade_{{ project_slug }}_{{ target_major }}
    build:
      context: {{ build_context }}
      dockerfile: {{ dockerfile_path }}
    image: openupgrade-{{ project_slug }}:{{ target_version }}
    depends_on: []
    networks:
      - project_network
    environment:
      HOST: "{{ db_host }}"
      USER: "{{ db_user }}"
      PASSWORD: "{{ db_password }}"
    volumes:
      - {{ filestore_volume }}:/var/lib/odoo
{%- for mount in addons_mounts %}
      - {{ mount.host }}:{{ mount.container }}:ro
{%- endfor %}
    command:
      - "--database={{ target_db }}"
      - "--db_host={{ db_host }}"
      - "--db_port=5432"
      - "--db_user={{ db_user }}"
      - "--db_password={{ db_password }}"
      - "--addons-path={{ addons_path }}"
      - "--update=all"
      - "--stop-after-init"
      - "--logfile=/var/lib/odoo/openupgrade.log"
      - "--log-level=info"
      - "--without-demo=all"

networks:
  project_network:
    name: {{ project_network }}
    external: true

volumes:
{%- for vol in external_volumes %}
  {{ vol }}:
    external: true
{%- endfor %}
